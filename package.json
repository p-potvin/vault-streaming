{
  "name": "vault-streaming",
  "version": "2.0.3",
  "description": "Vault Streaming Desktop App - TMDB movie & series browser.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node web/server.js",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": {
    "name": "VaultWares"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v43.0.0+wvcus",
    "electron-builder": "^26.15.3",
    "playwright": "^1.59.1"
  },
  "build": {
    "appId": "com.vaultwares.vaultstreaming",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "splash.html",
      "index.css",
      "themes.css",
      "themes.js",
      "js/**",
      "css/**",
      "src/**",
      "python-scripts/**",
      "vault_streaming/**",
      "public/**",
      "build/**",
      "vaultwares-themes/**",
      "node_modules/**",
      "!node_modules/playwright/**",
      "!node_modules/@playwright/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/builder-util/**",
      "!node_modules/electron-publish/**",
      "!node_modules/@electron/rebuild/**",
      "!node_modules/dmg-builder/**"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          ".env"
        ]
      }
    ],
    "asarUnpack": [
      "tools/**",
      "python-scripts/**",
      "vault_streaming/**"
    ],
	"electronLanguages": ["en-US", "fr-CA"], 
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
	  "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "VaultWares"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "vault-streaming-setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Vault Streaming"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "productName": "Vault Streaming"
  },
  "dependencies": {
    "express": "^5.2.1",
    "flag-icons": "^7.5.0",
    "node-fetch": "^3.3.2"
  },
  "allowScripts": {
    "electron@41.2.1": true,
    "electron-winstaller@5.4.0": true
  },
  "productName": "Vault Streaming"
}
