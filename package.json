{
  "name": "vault-streaming",
  "version": "1.8.0",
  "description": "VaultWares streaming client - Torrents + Real-Debrid via Comet, TMDB movie & series streaming.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v43.0.0+wvcus",
    "electron-builder": "^26.8.1",
    "playwright": "^1.59.1"
  },
  "build": {
    "appId": "com.vaultwares.vaultstreaming",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "splash.html",
      "index.css",
      "themes.css",
      "themes.js",
      "js/**",
      "css/**",
      "src/**",
      "python-scripts/**",
      "vault_streaming/**",
      "public/**",
      "build/**",
      "vaultwares-themes/**",
      "node_modules/**",
      "!node_modules/playwright/**",
      "!node_modules/@playwright/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/builder-util/**",
      "!node_modules/electron-publish/**",
      "!node_modules/@electron/rebuild/**",
      "!node_modules/dmg-builder/**"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          ".env"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "vault-streaming-setup-${version}.${ext}"
    },
	"electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "productName": "Vault Streaming"
  },
  "dependencies": {
    "express": "^5.2.1",
    "flag-icons": "^7.5.0",
    "node-fetch": "^3.3.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "allowScripts": {
    "electron@41.2.1": true,
    "electron-winstaller@5.4.0": true
  }
}
