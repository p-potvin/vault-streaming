TMDB_BEARER_TOKEN=
TMDB_API_TOKEN=
REAL_DEBRID_API_TOKEN=
# Comet Stremio addon stream base URL (without trailing /manifest.json).
# Example: http://100.67.25.118:5173/eyJ...==
# If unset, falls back to reading ../.access/comet_config.txt (manifest URL form is also accepted).
COMET_STREAM_BASE=
# OMDb (www.omdbapi.com), the third search source after the local catalog and TMDB
OMDB_API_KEY=
# Deepbrid, the fallback when Real-Debrid fails (src/deepbrid/client.js). If unset, read from
# ../.access/deepbrid_api_token.txt. Uses the proxy tunnel when one is enabled, else calls directly.
DEEPBRID_API_TOKEN=
# vault-raggae gateway: the local catalog every piece of metadata is served from (src/raggae.js)
RAGGAE_URL=http://127.0.0.1:8750
# Local trailer cache: trailers downloaded once and played from here (src/trailers.js)
TRAILER_CACHE_DIR=G:\VaultStreaming\trailers
# Watch regions the scheduled front-page ingest copies (scripts/ingest-front-page.js)
FRONT_PAGE_REGIONS=CA,US
